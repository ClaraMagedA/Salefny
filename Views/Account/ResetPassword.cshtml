@{
    ViewData["Title"] = "تعيين كلمة مرور جديدة";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="bg-white p-4 rounded-4 shadow-sm">
            <h4 class="fw-bold text-center mb-3"><span class="text-success">سَلِّفني</span> — كلمة مرور جديدة</h4>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" name="userId" value="@ViewBag.UserId" />
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label small fw-bold">كلمة المرور الجديدة</label>
                    <input id="newPassword" name="newPassword" type="password" class="form-control" minlength="6" required>
                </div>
                <div class="mb-4">
                    <label for="confirmPassword" class="form-label small fw-bold">تأكيد كلمة المرور الجديدة</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" minlength="6" required>
                    <div class="form-text small">يجب أن تتكون كلمة المرور من 6 أحرف على الأقل.</div>
                </div>

                <button type="submit" class="btn btn-emerald w-100 py-2">
                    <i class="fa-solid fa-key ms-1"></i> حفظ كلمة المرور الجديدة
                </button>
            </form>

            <div class="text-center small mt-3">
                <a asp-action="Login" class="text-success fw-bold text-decoration-none">العودة لتسجيل الدخول</a>
            </div>
        </div>
    </div>
</div>
