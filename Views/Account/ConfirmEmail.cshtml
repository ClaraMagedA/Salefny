@model bool
@{
    ViewData["Title"] = Model ? "تم تأكيد البريد الإلكتروني" : "تعذر تأكيد البريد الإلكتروني";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bg-white p-5 rounded-4 shadow-sm text-center">
            @if (Model)
            {
                <i class="fa-solid fa-envelope-circle-check text-success fs-1 mb-3"></i>
                <h4 class="fw-bold mb-3">تم تأكيد بريدك الإلكتروني بنجاح</h4>
                <p class="text-muted small mb-4">
                    يمكنك الآن استخدام حسابك بشكل كامل. إذا كنت ترغب في تغيير كلمة المرور، استخدم صفحة نسيت كلمة المرور.
                </p>
            }
            else
            {
                <i class="fa-solid fa-triangle-exclamation text-warning fs-1 mb-3"></i>
                <h4 class="fw-bold mb-3">تعذر تأكيد البريد الإلكتروني</h4>
                <p class="text-muted small mb-4">
                    الرابط غير صالح أو انتهت صلاحيته، أو أن الحساب غير موجود. يمكنك تسجيل الدخول وطلب رابط تأكيد جديد.
                </p>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-house ms-1"></i> الرئيسية
                </a>
                <a asp-action="Login" class="btn btn-emerald">تسجيل الدخول</a>
            </div>
        </div>
    </div>
</div>
