@model SalefnyMVC.Models.Entities.ApplicationUser
@{
    ViewData["Title"] = "تعديل البيانات الشخصية";
    ViewData["ActiveAccountTab"] = "Profile";
}

<div class="bg-white p-4 rounded-4 shadow-sm mb-5">
    @await Html.PartialAsync("_AccountNav")

    <h5 class="fw-bold mb-4"><i class="fa-solid fa-user-pen text-success ms-2"></i> تعديل البيانات الشخصية</h5>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success small"><i class="fa-solid fa-circle-check ms-1"></i> @success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger small"><i class="fa-solid fa-circle-exclamation ms-1"></i> @error</div>
    }

    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="FullName" class="form-label small fw-bold">الاسم الكامل</label>
                <input asp-for="FullName" class="form-control" maxlength="100" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="City" class="form-label small fw-bold">المحافظة</label>
                <input asp-for="City" class="form-control" maxlength="50" required />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label small fw-bold">رقم الهاتف (اختياري)</label>
                <input asp-for="PhoneNumber" class="form-control" maxlength="50" dir="ltr" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label for="profileImage" class="form-label small fw-bold">صورة الملف الشخصي (اختياري)</label>
                <input id="profileImage" name="profileImage" type="file" accept=".jpg,.jpeg,.png,.webp"
                       class="form-control" />
                <div class="form-text small">الصيغ المسموحة: JPG أو PNG أو WebP، وبحد أقصى 5 ميجابايت.</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
        {
            <div class="mt-4">
                <span class="text-muted small d-block mb-2">الصورة الحالية:</span>
                <img src="@Model.ProfileImagePath" alt="صورة الملف الشخصي" class="rounded-circle border"
                     style="width:72px;height:72px;object-fit:cover" />
            </div>
        }

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-emerald px-4">
                <i class="fa-solid fa-floppy-disk ms-1"></i> حفظ التغييرات
            </button>
            <a asp-action="Profile" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</div>
