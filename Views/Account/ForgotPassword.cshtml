@{
    ViewData["Title"] = "نسيت كلمة المرور";
    var sent = ViewBag.Sent is bool b && b;
    var demoLink = ViewBag.DemoResetLink as string;
    var message = ViewBag.Message as string;
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="bg-white p-4 rounded-4 shadow-sm">
            <h4 class="fw-bold text-center mb-3"><span class="text-success">سَلِّفني</span> — إعادة تعيين كلمة المرور</h4>
            <p class="text-muted small text-center">
                أدخل بريدك الإلكتروني وسنرسل لك رابطاً آمناً لتعيين كلمة مرور جديدة.
            </p>

            @if (sent)
            {
                <div class="alert alert-success small">
                    <i class="fa-solid fa-envelope-circle-check ms-1"></i>
                    @(string.IsNullOrWhiteSpace(message) ? "إذا كان هذا البريد مسجلاً لدينا، فستصلك رسالة إعادة تعيين كلمة المرور." : message)
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(demoLink))
            {
                <div class="alert alert-warning small">
                    <i class="fa-solid fa-triangle-exclamation ms-1"></i>
                    <strong>وضع تجريبي:</strong> خدمة SMTP غير مُعدّة، لذا لم يُرسل أي بريد.
                    الرابط التالي يظهر هنا لمحاكاة الرسالة:
                    <div class="mt-2 p-2 bg-white rounded border">
                        <a href="@demoLink" dir="ltr" class="small" style="word-break:break-all">@demoLink</a>
                    </div>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label for="email" class="form-label small fw-bold">البريد الإلكتروني</label>
                    <input id="email" name="email" type="email" class="form-control" dir="ltr"
                           placeholder="name@example.com" value="@ViewBag.Email" required>
                </div>
                <button type="submit" class="btn btn-emerald w-100 py-2">
                    <i class="fa-solid fa-paper-plane ms-1"></i> إرسال رابط إعادة التعيين
                </button>
            </form>

            <div class="text-center small mt-3">
                <a asp-action="Login" class="text-success fw-bold text-decoration-none">
                    <i class="fa-solid fa-arrow-right ms-1"></i> العودة لتسجيل الدخول
                </a>
            </div>
        </div>
    </div>
</div>
