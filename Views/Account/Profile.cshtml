@model SalefnyMVC.Models.Entities.ApplicationUser
@{
    ViewData["Title"] = "الملف الشخصي - حسابك الموثق";
    ViewData["ActiveAccountTab"] = "Profile";
}

<div class="bg-white p-4 rounded-4 shadow-sm mb-5">
    @await Html.PartialAsync("_AccountNav")

    @if (TempData["VerificationSuccess"] is string successMsg)
    {
        <div class="alert alert-success small"><i class="fa-solid fa-circle-check ms-1"></i> @successMsg</div>
    }
    @if (TempData["VerificationInfo"] is string infoMsg)
    {
        <div class="alert alert-info small"><i class="fa-solid fa-circle-info ms-1"></i> @infoMsg</div>
    }
    @if (TempData["DemoConfirmLink"] is string demoConfirmLink)
    {
        <div class="alert alert-warning small">
            <i class="fa-solid fa-triangle-exclamation ms-1"></i>
            <strong>وضع تجريبي:</strong> خدمة SMTP غير مُعدّة، لذا لم يُرسل بريد التأكيد.
            رابط التأكيد يظهر هنا لمحاكاة الرسالة:
            <a href="@demoConfirmLink" dir="ltr" class="d-block mt-1 small" style="word-break:break-all">@demoConfirmLink</a>
        </div>
    }

    <div class="d-flex justify-content-end mb-3">
        <a asp-action="EditProfile" class="btn btn-outline-success btn-sm">
            <i class="fa-solid fa-user-pen ms-1"></i> تعديل البيانات الشخصية
        </a>
    </div>

    <!-- Header Card -->
    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
            {
                <img src="@Model.ProfileImagePath" alt="@Model.FullName" class="rounded-circle border"
                     style="width: 60px; height: 60px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem;">
                    <i class="fa-solid fa-user"></i>
                </div>
            }
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h5 class="fw-bold mb-0">@Model.FullName</h5>
                    @if (Model.IsVerified)
                    {
                        <span class="badge-verified"><i class="fa-solid fa-circle-check ms-1"></i> حساب موثق (eKYC)</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-circle-exclamation ms-1"></i> حساب غير موثق</span>
                    }
                    @if (User.IsInRole(AppRoles.Renter))
                    {
                        <span class="badge bg-light text-dark border">مستأجر</span>
                    }
                    @if (User.IsInRole(AppRoles.Owner))
                    {
                        <span class="badge bg-success">مالك معتمد</span>
                    }
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <span class="badge bg-primary">مدير</span>
                    }
                    @if (User.IsInRole(AppRoles.SuperAdmin))
                    {
                        <span class="badge bg-dark">مدير عام</span>
                    }
                </div>
                <span class="text-muted small">
                    <i class="fa-solid fa-location-dot ms-1"></i> @Model.City | @Model.Email
                </span>
            </div>
        </div>
        <div class="d-flex gap-4 border-start pt-2 pt-md-0 pe-md-4">
            <div>
                <span class="text-muted small d-block">تقييم الثقة</span>
                @if (Model.TrustRating <= 0)
                {
                    <span class="fw-bold text-muted fs-6"><i class="fa-solid fa-star ms-1"></i> لا يوجد تقييم بعد</span>
                }
                else
                {
                    var filledStars = (int)Math.Round(Math.Clamp(Model.TrustRating, 0, 5), MidpointRounding.AwayFromZero);
                    <span class="fw-bold text-dark fs-6" dir="ltr">
                        @for (var s = 1; s <= 5; s++)
                        {
                            <i class="fa-solid fa-star @(s <= filledStars ? "text-warning" : "text-secondary")"></i>
                        }
                        <span class="small ms-1">@Model.TrustRating.ToString("0.0", CultureInfo.InvariantCulture) / 5.0</span>
                    </span>
                }
            </div>
            <div>
                <span class="text-muted small d-block">الضمان المحجوز حالياً</span>
                <span class="fw-bold text-success fs-5">@Model.EscrowBalance.ToString("N0", CultureInfo.InvariantCulture) ج.م</span>
            </div>
        </div>
    </div>

    <!-- eKYC Verification -->
    <div class="border rounded-3 p-4">
        <h6 class="fw-bold mb-3"><i class="fa-solid fa-shield-halved text-success ms-2"></i> بيانات توثيق الهوية الوطنية (eKYC)</h6>
        @if (Model.IsVerified)
        {
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 text-center bg-light">
                        <i class="fa-solid fa-address-card text-success fs-2 mb-2"></i>
                        <h6 class="fw-bold mb-1">تم التحقق من البطاقة الشخصية بنجاح</h6>
                        <span class="text-muted small">تتيح لك الهوية الموثقة إمكانية استئجار المنتجات ذات القيم العالية فوراً.</span>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="bg-light p-3 rounded-3">
                        <div class="row g-2 text-muted small">
                            <div class="col-6">رقم الهاتف: <strong class="text-dark d-block">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "غير مسجل" : Model.PhoneNumber)</strong></div>
                            <div class="col-6">البريد الإلكتروني: <strong class="text-dark d-block" dir="ltr">@Model.Email</strong></div>
                            <div class="col-12 mt-2">المحافظة: <strong class="text-dark d-block">@Model.City</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning">
                <h6 class="fw-bold mb-1"><i class="fa-solid fa-circle-exclamation text-warning ms-1"></i> لم يتم توثيق هويتك بعد</h6>
                <p class="text-muted small mb-3">
                    يمكنك تصفح الأغراض وحجزها، لكن استئجار المنتجات ذات القيم العالية يتطلب توثيق الهوية (eKYC)
                    برقم الهاتف ورمز التحقق (OTP).
                </p>
                <a asp-controller="Verification" asp-action="Verify" class="btn btn-emerald btn-sm">
                    <i class="fa-solid fa-id-card ms-1"></i> توثيق الهوية الآن
                </a>
            </div>
        }
    </div>
</div>
