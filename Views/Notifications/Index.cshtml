@model IEnumerable<Notification>
@{
    ViewData["Title"] = "الإشعارات";
    ViewData["ActiveAccountTab"] = "Notifications";
    var notifications = Model?.ToList() ?? new List<Notification>();
    var unread = ViewBag.UnreadCount is int count ? count : notifications.Count(n => !n.IsRead);
}

<div class="bg-white p-4 rounded-4 shadow-sm mb-5">
    @await Html.PartialAsync("_AccountNav")

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success small mt-3"><i class="fa-solid fa-circle-check ms-1"></i> @success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger small mt-3"><i class="fa-solid fa-circle-exclamation ms-1"></i> @error</div>
    }

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h5 class="fw-bold mb-0">
            <i class="fa-solid fa-bell text-success ms-2"></i> إشعاراتك
            @if (unread > 0)
            {
                <span class="badge rounded-pill bg-danger" dir="ltr">@unread</span>
            }
        </h5>
        @if (unread > 0)
        {
            <form asp-action="MarkAll" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-success btn-sm">
                    <i class="fa-solid fa-check-double ms-1"></i> تحديد الكل كمقروء
                </button>
            </form>
        }
    </div>

    @if (!notifications.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-bell-slash fa-3x mb-3 d-block opacity-50"></i>
            <p class="mb-0">لا توجد إشعارات بعد.</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notification in notifications)
            {
                <div class="list-group-item d-flex justify-content-between align-items-start gap-3 @(notification.IsRead ? "" : "list-group-item-light")">
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <i class="fa-solid @(notification.IsRead ? "fa-envelope-open" : "fa-envelope") text-success"></i>
                            <span class="@(notification.IsRead ? "text-muted" : "fw-bold")">@notification.Message</span>
                            @if (!notification.IsRead)
                            {
                                <span class="badge bg-success">جديد</span>
                            }
                        </div>
                        <div class="text-muted small mt-1">
                            @if (!string.IsNullOrWhiteSpace(notification.EventType))
                            {
                                <span class="badge bg-light text-dark border">@notification.EventType</span>
                            }
                            <span>@notification.CreatedAt.ToLocalTime().ToString("d MMM yyyy - HH:mm")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(notification.ActionUrl) && Url.IsLocalUrl(notification.ActionUrl))
                        {
                            <a href="@notification.ActionUrl" class="small text-success fw-bold text-decoration-none d-inline-block mt-2">
                                <i class="fa-solid fa-arrow-left ms-1"></i> عرض التفاصيل
                            </a>
                        }
                    </div>

                    @if (!notification.IsRead)
                    {
                        <form asp-action="MarkRead" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@notification.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="تحديد كمقروء">
                                <i class="fa-solid fa-check"></i>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
