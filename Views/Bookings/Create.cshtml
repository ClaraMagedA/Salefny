@{
    ViewData["Title"] = "حجز الغرض والدفع الآمن";
}

<style>
    .dark-checkout-card {
        background-color: #0f172a;
        color: white;
        border-radius: 16px;
        padding: 24px;
    }
</style>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="bg-white p-4 rounded-4 shadow-sm">
            <h5 class="fw-bold mb-4"><i class="fa-solid fa-circle-check text-success ms-2"></i> تأكيد طلب استعارة الغرض والوديعة</h5>

            <!-- Item Header -->
            <div class="d-flex align-items-center gap-3 bg-light p-3 rounded-3 mb-4">
                <img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=100&q=80" class="rounded" alt="camera" style="width: 70px; height: 70px; object-fit: cover;">
                <div>
                    <span class="badge bg-success mb-1">تصوير وسينما</span>
                    <h6 class="fw-bold mb-1">كاميرا Canon EOS R6 Mark II + عدسة RF 24-70mm</h6>
                    <span class="text-muted small"><i class="fa-solid fa-location-dot ms-1"></i> القاهرة - المعادي | المالك: أحمد م. (موثق)</span>
                </div>
            </div>

            <form asp-controller="Bookings" asp-action="ConfirmBooking" method="post">
                <!-- Dates -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">تاريخ بدء الاستلام</label>
                        <input type="date" name="StartDate" class="form-control" value="2026-10-25">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">تاريخ الإرجاع</label>
                        <input type="date" name="EndDate" class="form-control" value="2026-10-27">
                    </div>
                </div>

                <!-- Delivery Method -->
                <label class="form-label small fw-bold">طريقة التسليم والاستلام المباشر</label>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 bg-light d-flex align-items-center gap-2">
                            <input type="radio" name="deliveryMethod" id="d1" value="Handover" checked>
                            <label for="d1" class="small fw-bold mb-0">مقابلة مباشرة (يد بيد)<br><span class="text-muted fw-normal">في مكان عام متفق عليه (مجاناً)</span></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 bg-light d-flex align-items-center gap-2">
                            <input type="radio" name="deliveryMethod" id="d2" value="Courier">
                            <label for="d2" class="small fw-bold mb-0">مندوب توصيل (Uber / InDrive)<br><span class="text-muted fw-normal">يتحمل المستأجر التكلفة</span></label>
                        </div>
                    </div>
                </div>

                <!-- Local Payment Methods -->
                <label class="form-label small fw-bold">طريقة الدفع المحلية المتاحة</label>
                <div class="row g-2 mb-4">
                    <div class="col-3">
                        <div class="border rounded-3 p-2 text-center bg-light">
                            <i class="fa-solid fa-mobile-screen text-success fs-4 d-block mb-1"></i>
                            <span class="small fw-bold">InstaPay</span>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded-3 p-2 text-center bg-light">
                            <i class="fa-solid fa-wallet text-danger fs-4 d-block mb-1"></i>
                            <span class="small fw-bold">فودافون كاش</span>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded-3 p-2 text-center bg-light">
                            <i class="fa-solid fa-credit-card text-primary fs-4 d-block mb-1"></i>
                            <span class="small fw-bold">بطاقة بنكية</span>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded-3 p-2 text-center bg-light">
                            <i class="fa-solid fa-money-bill-wave text-success fs-4 d-block mb-1"></i>
                            <span class="small fw-bold">كاش عند التسليم</span>
                        </div>
                    </div>
                </div>

                <!-- Dark Escrow Calculation Breakdown -->
                <div class="dark-checkout-card mb-4">
                    <div class="d-flex justify-content-between mb-2 small">
                        <span>إيجار الكاميرا (2 يوم × 450 ج.م):</span>
                        <strong>900 ج.م</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small">
                        <span>رسوم خدمة منصة سَلِّفني (10%):</span>
                        <strong>90 ج.م</strong>
                    </div>
                    <hr class="border-secondary">
                    <div class="d-flex justify-content-between mb-2 text-warning small">
                        <span>قيمة الوديعة المحتجزة مؤقتاً (تُسترد فور الفحص):</span>
                        <strong>3,000 ج.م</strong>
                    </div>
                    <hr class="border-secondary">
                    <div class="d-flex justify-content-between align-items-center pt-1">
                        <span class="fw-bold fs-6">المبلغ الإجمالي للدفع:</span>
                        <span class="fw-bold fs-4 text-success">3,990 ج.م</span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-light">إلغاء</a>
                    <button type="submit" class="btn btn-emerald px-4">تأكيد الحجز والدفع الآمن</button>
                </div>
            </form>
        </div>
    </div>
</div>