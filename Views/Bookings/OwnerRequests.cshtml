@model IEnumerable<Booking>
@using SalefnyMVC.Services
@{
    ViewData["Title"] = "طلبات الاستعارة الواردة";
    ViewData["ActiveAccountTab"] = "OwnerRequests";

    Func<string?, string> paymentName = p => p switch
    {
        "InstaPay" => "InstaPay",
        "OPay" => "OPay",
        "VodafoneCash" => "فودافون كاش",
        "BankCard" => "بطاقة بنكية",
        "CashOnDelivery" => "كاش عند التسليم",
        _ => "غير محدد"
    };
    Func<BookingStatus, string> statusName = s => s switch
    {
        BookingStatus.Pending => "بانتظار موافقتك",
        BookingStatus.Approved => "موافقة — بانتظار الاستلام",
        BookingStatus.Active => "نشط",
        BookingStatus.Completed => "مكتمل",
        BookingStatus.Cancelled => "ملغي",
        BookingStatus.Rejected => "مرفوض",
        BookingStatus.Disputed => "متنازع عليه",
        _ => s.ToString()
    };
}

<div class="bg-white p-4 rounded-4 shadow-sm">
    @await Html.PartialAsync("_AccountNav")

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success small mt-3">
            <i class="fa-solid fa-circle-check ms-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger small mt-3">
            <i class="fa-solid fa-circle-exclamation ms-1"></i> @TempData["Error"]
        </div>
    }

    <h5 class="fw-bold mb-4"><i class="fa-solid fa-clipboard-check text-success ms-2"></i> طلبات الاستعارة الواردة لمنتجاتك</h5>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-inbox fa-3x mb-3 d-block opacity-50"></i>
            <p>لا توجد طلبات استعارة على منتجاتك حتى الآن.</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var booking in Model)
            {
                var receiptInspection = booking.Inspections?.FirstOrDefault(i => i.Stage == InspectionStage.ReceiptByOwner);
                <div class="list-group-item p-3 rounded-3 border mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h6 class="fw-bold mb-1">طلب استعارة: @booking.Item?.Title <code class="small">#ORD-@booking.Id</code></h6>
                            <span class="text-muted small d-block">
                                المستأجر: @booking.Renter?.FullName | المدة: @booking.StartDate.ToString("d MMM") - @booking.EndDate.ToString("d MMM")
                            </span>
                            <span class="text-muted small d-block mt-1">
                                الدفع: @paymentName(booking.PaymentMethod)
                                @if (!string.IsNullOrWhiteSpace(booking.PaymentReference))
                                {
                                    <text> | رقم العملية: @booking.PaymentReference</text>
                                }
                                <text> | التسليم: @(booking.DeliveryMethod == "Courier" ? "مندوب توصيل" : "مقابلة مباشرة")</text>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(booking.DeliveryDetails))
                            {
                                <span class="text-muted small d-block">بيانات الاستلام: @booking.DeliveryDetails</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.RenterNote))
                            {
                                <span class="text-muted small d-block">ملاحظة المستأجر: @booking.RenterNote</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.CancellationReason))
                            {
                                <span class="text-danger small d-block">سبب الإلغاء: @booking.CancellationReason</span>
                            }
                        </div>
                        <span class="badge bg-secondary">@statusName(booking.Status)</span>
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
                        <a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-outline-secondary btn-sm">
                            <i class="fa-solid fa-circle-info ms-1"></i> تفاصيل الحجز
                        </a>

                        @if (BusinessRules.CanCancel(booking, DateTime.Now))
                        {
                            <form asp-action="Cancel" asp-route-id="@booking.Id" method="post" class="d-flex gap-1 align-items-center">
                                <input type="text" name="reason" class="form-control form-control-sm" style="max-width: 180px;"
                                       maxlength="300" placeholder="سبب الإلغاء (اختياري)" aria-label="سبب الإلغاء">
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('هل تريد إلغاء هذا الحجز؟');">
                                    <i class="fa-solid fa-xmark ms-1"></i> إلغاء الحجز
                                </button>
                            </form>
                        }

                        @if (booking.Status == BookingStatus.Pending)
                        {
                            <form asp-action="Approve" asp-route-id="@booking.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm px-3"><i class="fa-solid fa-check ms-1"></i> قبول الطلب</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@booking.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3"><i class="fa-solid fa-xmark ms-1"></i> رفض الطلب</button>
                            </form>
                        }
                        else if (booking.Status == BookingStatus.Approved && !booking.IsDelivered)
                        {
                            <form asp-action="MarkDelivered" asp-route-id="@booking.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-handshake ms-1"></i> تم تسليم الغرض</button>
                            </form>
                        }
                        else if (booking.IsDelivered && booking.ReturnedAt == null)
                        {
                            <span class="badge bg-success"><i class="fa-solid fa-truck ms-1"></i> الغرض مُسلَّم — بانتظار إعادة المستأجر</span>
                        }

                        @if (booking.ReturnedAt != null)
                        {
                            <span class="badge bg-info text-dark"><i class="fa-solid fa-rotate-left ms-1"></i> وصل للإرجاع @booking.ReturnedAt?.ToString("d MMM HH:mm")</span>
                            <a asp-controller="Disputes" asp-action="InspectionStudio" asp-route-bookingId="@booking.Id" asp-route-mode="return" class="btn btn-success btn-sm">
                                <i class="fa-solid fa-camera ms-1"></i> فحص الاستلام (6 زوايا)
                            </a>
                            <a asp-controller="Disputes" asp-action="InspectionStudio" asp-route-bookingId="@booking.Id" asp-route-mode="damage" class="btn btn-outline-danger btn-sm">
                                <i class="fa-solid fa-triangle-exclamation ms-1"></i> إبلاغ عن ضرر
                            </a>
                            @if (receiptInspection != null)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-circle-check ms-1"></i> الفحص محفوظ</span>
                            }
                            @if (receiptInspection?.DamageReported == true || booking.DisputeLog != null)
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-triangle-exclamation ms-1"></i> بلاغ ضرر مفتوح</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
