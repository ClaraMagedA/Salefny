@model AdminDisputesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "منازعات فحص الـ 6 زوايا وتسوية الأضرار";
}

@if (TempData["AdminMessage"] is string message)
{
    <div class="alert alert-success small"><i class="fa-solid fa-circle-check ms-1"></i> @message</div>
}
@if (TempData["AdminError"] is string error)
{
    <div class="alert alert-danger small"><i class="fa-solid fa-triangle-exclamation ms-1"></i> @error</div>
}

<div class="bg-white p-4 rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation text-danger ms-2"></i> منازعات فحص الـ 6 زوايا وتسوية الأضرار</h5>
            <span class="text-muted small">مراجعة ادعاءات الأطراف واتخاذ القرار المالي للضمان.</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-danger">نشطة: @Model.PendingCount.ToString("N0")</span>
            @if (Model.ShowResolved)
            {
                <a asp-action="Disputes" asp-route-showResolved="false" class="btn btn-emerald btn-sm">عرض النزاعات النشطة</a>
            }
            else
            {
                <a asp-action="Disputes" asp-route-showResolved="true" class="btn btn-outline-secondary btn-sm">عرض النزاعات المسوّاة</a>
            }
        </div>
    </div>

    @if (!Model.Disputes.Any())
    {
        <div class="alert alert-info small mb-0">لا توجد نزاعات @(Model.ShowResolved ? "مسوّاة" : "نشطة") حالياً.</div>
    }
    else
    {
        <div class="d-grid gap-4">
            @foreach (var dispute in Model.Disputes)
            {
                <div class="border rounded-4 p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <h6 class="fw-bold mb-1">
                                @if (!string.IsNullOrWhiteSpace(dispute.ItemImagePath))
                                {
                                    <img src="@dispute.ItemImagePath" alt="@dispute.ItemTitle" class="rounded ms-1" width="38" height="38" style="object-fit:cover;">
                                }
                                @dispute.ItemTitle <span class="text-muted small">— حجز رقم @dispute.BookingId</span>
                            </h6>
                            <div class="text-muted small">
                                المؤجر: <strong>@dispute.OwnerName</strong> <span dir="ltr">(@dispute.OwnerEmail)</span> •
                                المستأجر: <strong>@dispute.RenterName</strong> <span dir="ltr">(@dispute.RenterEmail)</span>
                            </div>
                            <div class="text-muted small">
                                مدة الحجز: @dispute.StartDate.ToString("yyyy/MM/dd") — @dispute.EndDate.ToString("yyyy/MM/dd") •
                                ادعاء: @dispute.ClaimDescription
                            </div>
                        </div>
                        <div class="text-end">
                            @if (dispute.IsResolved)
                            {
                                <span class="badge bg-success">مسوّى</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">قيد المراجعة</span>
                            }
                            <div class="text-muted small mt-1">@dispute.LoggedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <span class="small text-muted d-block">مبلغ التأمين</span>
                            <strong class="text-danger">@dispute.EscrowDepositAmount.ToString("N2") ج.م</strong>
                        </div>
                        <div class="col-md-4">
                            <span class="small text-muted d-block">حالة الحجز / الضمان</span>
                            <span class="badge bg-secondary">@dispute.BookingStatus</span>
                            <span class="badge bg-info text-dark">@dispute.DepositStatus</span>
                        </div>
                        <div class="col-md-4">
                            <span class="small text-muted d-block">المبلغ المخصوم</span>
                            <strong>@dispute.DeductedDepositAmount.ToString("N2") ج.م</strong>
                        </div>
                    </div>

                    <h6 class="fw-bold small mb-2"><i class="fa-solid fa-images ms-1"></i> صور الإرجاع (6 زوايا)</h6>
                    @if (dispute.ReturnPhotos.Any())
                    {
                        <div class="row g-2 mb-3">
                            @foreach (var photo in dispute.ReturnPhotos.Take(6))
                            {
                                <div class="col-6 col-md-4 col-lg-2 text-center">
                                    <a href="@photo" target="_blank">
                                        <img src="@photo" alt="صورة إرجاع" class="img-fluid rounded border" style="height:90px;width:100%;object-fit:cover;">
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border small mb-3">لا توجد صور إرجاع مرفقة.</div>
                    }

                    @if (dispute.IsResolved)
                    {
                        <div class="small text-muted border-top pt-2">
                            <i class="fa-solid fa-clock-rotate-left ms-1"></i>
                            سُوّي في @dispute.ResolvedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            @if (!string.IsNullOrWhiteSpace(dispute.ResolutionNote))
                            {
                                <span>— @dispute.ResolutionNote</span>
                            }
                        </div>
                    }
                    else
                    {
                        <form asp-action="ResolveDispute" asp-route-id="@dispute.Id" method="post" class="border-top pt-3">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold">ملاحظة القرار</label>
                                    <input type="text" name="resolutionNote" class="form-control form-control-sm" placeholder="سبب القرار والملخص" required>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">مبلغ الخصم (ج.م)</label>
                                    <input type="number" name="deductedAmount" value="0" min="0" step="0.01" max="@dispute.EscrowDepositAmount" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-2">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="refundFull" value="true" id="refund-@dispute.Id">
                                        <label class="form-check-label small fw-bold" for="refund-@dispute.Id">إرجاع كامل الضمان</label>
                                    </div>
                                    <input type="hidden" name="refundFull" value="false">
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-dark btn-sm w-100"
                                            onclick="return confirm('سيتم تحويل مبلغ الضمان وإغلاق النزاع. هل تريد المتابعة؟');">
                                        <i class="fa-solid fa-scale-balanced ms-1"></i> اعتماد التسوية
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
