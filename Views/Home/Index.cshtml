@model IEnumerable<Item>
@{
    ViewData["Title"] = "الرئيسية";
    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    var fallbackImage = "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=600&q=80";
    var cities = new[] { "القاهرة", "الجيزة", "الإسكندرية", "الدقهلية", "جنوب سيناء" };
}

<style>
    .hero-banner {
        background: linear-gradient(135deg, #064e3b 0%, #0d9488 100%);
        border-radius: 24px;
        padding: 48px 24px;
        color: white;
        text-align: center;
        box-shadow: 0 10px 25px -5px rgba(13, 148, 136, 0.3);
    }

    .hero-title {
        font-weight: 800;
        font-size: 2.3rem;
        margin-bottom: 24px;
    }

    .search-box-container {
        background: white;
        border-radius: 50px;
        padding: 8px 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        max-width: 900px;
        margin: 0 auto;
    }

    .search-input {
        border: none;
        outline: none;
        width: 100%;
        padding: 8px;
        font-size: 0.95rem;
    }

    .search-select {
        border: none;
        outline: none;
        background: transparent;
        color: #64748b;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0 8px;
    }

    .item-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: white;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .item-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -5px rgba(0,0,0,0.1);
        }

    .card-img-wrapper {
        position: relative;
        height: 190px;
        overflow: hidden;
    }

        .card-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .location-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(15, 23, 42, 0.75);
        color: white;
        backdrop-filter: blur(4px);
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success small">
        <i class="fa-solid fa-circle-check ms-1"></i> @TempData["Success"]
    </div>
}

<!-- Hero & Search Section -->
<section class="mb-5">
    <div class="hero-banner">
        <h1 class="hero-title">استأجر كل ما تحتاجه بأمان<br>من جيرانك ومحيطك السكني</h1>

        <form asp-controller="Items" asp-action="Index" method="get" class="search-box-container d-flex align-items-center flex-wrap flex-md-nowrap gap-2">
            <div class="d-flex align-items-center flex-grow-1 px-2">
                <i class="fa-solid fa-magnifying-glass text-muted ms-2"></i>
                <input type="text" name="keyword" class="search-input" placeholder="عن ماذا تبحث؟ (كاميرا، خيمة، سُلَّم...)" />
            </div>
            <div class="border-start d-none d-md-block" style="height: 30px;"></div>
            <div class="d-flex align-items-center px-2">
                <i class="fa-solid fa-location-dot text-muted ms-2"></i>
                <select name="city" class="search-select">
                    <option value="">جميع المحافظات المصرية</option>
                    @foreach (var city in cities)
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>
            <div class="border-start d-none d-md-block" style="height: 30px;"></div>
            <div class="d-flex align-items-center px-2">
                <i class="fa-solid fa-layer-group text-muted ms-2"></i>
                <select name="categoryId" class="search-select">
                    <option value="">جميع الأقسام</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-emerald px-4 rounded-pill">بحث</button>
        </form>
    </div>
</section>

<!-- Item Grid -->
<section class="mb-5 pb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-grid-2 text-success ms-2"></i>الأغراض المتاحة للتأجير الآن</h4>
        <span class="text-muted small">@Model.Count() غرضاً معروضاً</span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-box-open fa-3x mb-3 d-block opacity-50"></i>
            <p>لا توجد أغراض متاحة حالياً.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var image = item.ItemImages?.OrderBy(i => i.AngleIndex).FirstOrDefault()?.ImagePath ?? fallbackImage;
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="item-card h-100">
                        <div class="card-img-wrapper">
                            <span class="location-badge"><i class="fa-solid fa-location-dot ms-1"></i>@item.City</span>
                            <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id">
                                <img src="@image" alt="@item.Title" />
                            </a>
                        </div>
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <span class="text-success small fw-bold">@item.Category?.Name</span>
                            <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                <h6 class="fw-bold mt-1">@item.Title</h6>
                            </a>
                            <p class="text-muted small mb-3"><i class="fa-solid fa-user ms-1"></i>المالك: @item.Owner?.FullName</p>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto gap-2">
                                <div>
                                    <span class="fw-bold text-dark fs-5">@item.PricePerDay.ToString("N0") ج.م</span>
                                    <span class="text-muted small">/ اليوم</span>
                                </div>
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-emerald btn-sm">عرض التفاصيل والفحص</a>
                                   
                               
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>