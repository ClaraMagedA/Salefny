@{
    ViewData["Title"] = "حدث خطأ";
    var status = ViewBag.StatusCode is int code ? code : 500;
    var title = status switch
    {
        403 => "لا تملك صلاحية الوصول",
        404 => "الصفحة غير موجودة",
        500 => "حدث خطأ غير متوقع",
        _ => "تعذر إتمام الطلب"
    };
    var message = status switch
    {
        403 => "ليست لديك الصلاحية الكافية لعرض هذه الصفحة. تواصل مع الإدارة إذا كنت تعتقد أن هذا خطأ.",
        404 => "ربما تم نقل الصفحة أو حذفها، أو أن الرابط الذي استخدمته غير صحيح.",
        500 => "حدث خطأ أثناء معالجة طلبك. يرجى المحاولة مرة أخرى بعد قليل.",
        _ => "يرجى المحاولة مرة أخرى أو العودة إلى الصفحة الرئيسية."
    };
    var icon = status switch
    {
        403 => "fa-lock",
        404 => "fa-map-location-dot",
        _ => "fa-triangle-exclamation"
    };
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="bg-white p-5 rounded-4 shadow-sm text-center">
            <i class="fa-solid @icon text-warning fs-1 mb-3"></i>
            <div class="display-4 fw-bold text-success mb-2" dir="ltr">@status</div>
            <h4 class="fw-bold mb-3">@title</h4>
            <p class="text-muted mb-4">@message</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-emerald px-4">
                <i class="fa-solid fa-house ms-1"></i> العودة إلى الصفحة الرئيسية
            </a>
        </div>
    </div>
</div>
