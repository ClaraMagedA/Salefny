@{
    ViewData["Title"] = "نتائج البحث في السوق";
}

<div class="bg-white p-4 rounded-4 shadow-sm mb-4">
    <h4 class="fw-bold mb-3"><i class="fa-solid fa-magnifying-glass text-success ms-2"></i> نتائج تصفح الأغراض المتاحة</h4>
    <div class="row g-2">
        <div class="col-md-4"><input type="text" class="form-control" placeholder="بحث بالاسم..."></div>
        <div class="col-md-3">
            <select class="form-select">
                <option>جميع المحافظات</option>
                <option>القاهرة</option>
                <option>الجيزة</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select">
                <option>جميع الفئات</option>
                <option>تصوير</option>
                <option>تخييم</option>
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-emerald w-100">تصفية</button></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-4">
        <div class="item-card bg-white border rounded-4 p-3">
            <h6 class="fw-bold">كاميرا Sony Alpha A7 III</h6>
            <p class="text-muted small">المعادي، القاهرة</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-success fs-5">850 ج.م / يوم</span>
                <a asp-action="Details" asp-route-id="1" class="btn btn-emerald btn-sm">التفاصيل</a>
            </div>
        </div>
    </div>
</div>